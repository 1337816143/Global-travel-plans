# Public browser configuration only. Never place secrets in VITE_* variables.
VITE_GTP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_GTP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Server-only placeholders for a future ADR-backed gateway. These are not used by GitHub Pages.
GTP_SERVER_AMAP_WEB_KEY=
GTP_SERVER_PROVIDER_SIGNING_SECRET=
